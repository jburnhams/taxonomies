{
  "name": "taxonomies-site",
  "private": true,
  "type": "module",
  "description": "The explorer site for jburnhams/taxonomies, generated from the domain files and built on strata-react.",
  "scripts": {
    "data": "python3 generate.py",
    "dev": "npm run data && vite",
    "build": "npm run data && vite build",
    "typecheck": "tsc --noEmit",
    "check": "python3 generate.py --check && tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.108.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.3",
    "strata-react": "^1.3.22"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
